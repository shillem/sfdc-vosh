{
  "name": "sfdc-vosh",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce Vosh",
  "scripts": {
    "code:analyze": "sf code-analyzer run --rule-selector regex --rule-selector eslint --rule-selector pmd:Apex --rule-selector AppExchange --severity-threshold Moderate",
    "code:analyze:all": "bun run code:analyze -- --target utils-app extended-ui-app enhanced-campaigns-app incubator-app",
    "prepare": "husky",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --list-different \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "test": "bun run test:unit",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.2.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.3.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prettier-plugin-apex": "^2.2.6"
  }
}
